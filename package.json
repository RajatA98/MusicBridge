{
  "name": "musicbridge",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:rules": "firebase emulators:exec --only firestore 'jest __tests__/firestore-rules.test.ts'",
    "deploy:hosting": "expo export --platform web && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy:functions": "cd functions && npm run build && cd .. && firebase deploy --only functions"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@motiz88/react-native-midi": "0.0.6",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@sentry/react-native": "~6.10.0",
    "expo": "^49.0.23",
    "expo-application": "~6.0.0",
    "expo-clipboard": "~7.0.0",
    "expo-constants": "~17.0.0",
    "expo-device": "~7.0.0",
    "expo-linking": "^7.1.7",
    "expo-router": "~5.0.0",
    "expo-speech": "~13.0.0",
    "expo-splash-screen": "^55.0.20",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~4.0.0",
    "firebase": "^12.0.0",
    "nativewind": "4.1.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "0.79.0",
    "react-native-gesture-handler": "~2.22.0",
    "react-native-reanimated": "~3.16.0",
    "react-native-safe-area-context": "5.0.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.20.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^29.5.0",
    "@types/react": "~19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "^29.0.0",
    "jest-expo": "^47.0.1",
    "prettier": "^3.4.0",
    "typescript": "~5.7.0"
  },
  "engines": {
    "node": ">=22"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|nativewind|@motiz88|firebase|@firebase))"
    ],
    "setupFilesAfterEach": [
      "<rootDir>/__tests__/setup.ts"
    ]
  }
}
