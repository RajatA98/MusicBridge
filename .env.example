# MusicBridge — environment variables.
# Copy this to .env (or .env.local) and fill in real values.
# All EXPO_PUBLIC_* values are baked into the client bundle and are not secrets.

# Firebase web config — find in Firebase Console > Project Settings > Your apps > Web app.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=musicbridge-dev.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=musicbridge-dev
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=musicbridge-dev.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Sentry DSN — created in sentry.io project settings.
EXPO_PUBLIC_SENTRY_DSN=

# The Universal Links / App Links host (no scheme).
EXPO_PUBLIC_ASSOCIATED_DOMAIN=app.musicbridge.example

# Sentry source-map upload (used by Expo plugin at build time).
SENTRY_ORG=
SENTRY_PROJECT=

# Cloud Functions secret — set with `firebase functions:secrets:set ANTHROPIC_API_KEY`
# (NOT in this file — secrets do not live in env files for production).
